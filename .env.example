# Runtime do TGR-CRM
DATABASE_URL=mysql://usuario:senha@localhost:3306/tgr_crm
JWT_SECRET=troque-por-um-segredo-forte
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Gateway Asaas — nunca commitar valores reais
ASAAS_API_KEY=
# Obrigatória (https) quando ASAAS_API_KEY estiver definida; sem ela o Asaas fica desligado (KAN-31: sem fallback para produção).
ASAAS_API_URL=https://sandbox.asaas.com
ASAAS_WEBHOOK_TOKEN=

# Homologação isolada — use banco descartável e dados sem PII
E2E_STRICT=0
E2E_DATABASE_URL=mysql://e2e:e2e@localhost:3306/tgr_crm_e2e

# Integrações TGR (opcionais). Endpoint e chave sempre em par; sem o par o CRM não sobe. Chaves diferentes por ligação.
SALES_COMMAND_INTEGRATION_KEY=      # recebida do Sales (venda -> contrato)
RELATIONSHIP_ENDPOINT=
RELATIONSHIP_CRM_INTEGRATION_KEY=
SALES_COMMAND_ENDPOINT=             # cancelamento CRM -> Sales (crm.contract.cancelled.v1)
SALES_COMMAND_CANCELLATION_KEY=     # = CRM_CANCELLATION_INTEGRATION_KEY no Sales
FINANCIAL_ENDPOINT=
FINANCIAL_CRM_INTEGRATION_KEY=      # = FINANCIAL_CRM_INTEGRATION_KEY no Financial
FINANCIAL_PROJECT_EXTERNAL_KEY=     # id do projeto no Sales/Financial
FINANCIAL_PROJECT_NAME=
FINANCIAL_PROJECT_TIMEZONE=America/Recife
HOST=                               # opcional; ex.: 127.0.0.1. Vazio = todas as interfaces
