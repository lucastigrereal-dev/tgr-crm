# Runtime do TGR-CRM
DATABASE_URL=mysql://usuario:senha@localhost:3306/tgr_crm
JWT_SECRET=troque-por-um-segredo-forte
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Gateway Asaas — nunca commitar valores reais
ASAAS_API_KEY=
# Obrigatória (https) quando ASAAS_API_KEY estiver definida; sem ela o Asaas fica desligado (KAN-31: sem fallback para produção).
ASAAS_API_URL=https://sandbox.asaas.com
ASAAS_WEBHOOK_TOKEN=

# Homologação isolada — use banco descartável e dados sem PII
E2E_STRICT=0
E2E_DATABASE_URL=mysql://e2e:e2e@localhost:3306/tgr_crm_e2e

# Integrações TGR (opcionais). Endpoint e chave sempre em par; sem o par o CRM não sobe. Chaves diferentes por ligação.
SALES_COMMAND_INTEGRATION_KEY=      # recebida do Sales (venda -> contrato)
RENEGOTIATION_SELF_APPROVAL=false  # CRM-A11: false = quem propôs o acordo de parcela não pode aprová-lo. true libera (operação de uma pessoa só).
GATEWAY_RECOVERY_ENABLED=true  # CRM-A10: reconcilia cobranças Asaas órfãs (só lê o gateway). Intervalo GATEWAY_RECOVERY_INTERVAL_MINUTES (5), idade mínima GATEWAY_RECOVERY_MIN_AGE_MINUTES (10).
ORPHAN_BLOB_SWEEP_ENABLED=false  # CRM-A07: varredura de arquivo órfão no armazenamento local. Ligada sem DELETE só relata.
ORPHAN_BLOB_SWEEP_DELETE=false  # só apaga com os dois ligados; idade mínima ORPHAN_BLOB_MIN_AGE_HOURS (24), intervalo ORPHAN_BLOB_SWEEP_INTERVAL_HOURS (24).
ENCOUNTER_TIMES_RECEIVER_ENABLED=false  # receptor encounter.times_recorded.v1 (POST .../encounter-times). Deixe false até o Sales emitir o evento e o contrato ser aceito.
COMMISSION_V2_RELEASED=false  # política de comissão V2 (rulesV2 do empreendimento). TRAVADA por padrão: false = nenhum pagamento lê as regras V2. Liberar é decisão do Lucas.
NQ_READ_ENDPOINT_ENABLED=false  # leitura do NQ pelo Sales (GET /api/integrations/sales-command/nq/:coupleCode). Deixe false até o aceite do Lucas.
RELATIONSHIP_ENDPOINT=
RELATIONSHIP_CRM_INTEGRATION_KEY=
SALES_COMMAND_ENDPOINT=             # cancelamento CRM -> Sales (crm.contract.cancelled.v1)
SALES_COMMAND_CANCELLATION_KEY=     # = CRM_CANCELLATION_INTEGRATION_KEY no Sales
FINANCIAL_ENDPOINT=
FINANCIAL_CRM_INTEGRATION_KEY=      # = FINANCIAL_CRM_INTEGRATION_KEY no Financial
FINANCIAL_PROJECT_EXTERNAL_KEY=     # id do projeto no Sales/Financial
FINANCIAL_PROJECT_NAME=
FINANCIAL_PROJECT_TIMEZONE=America/Recife
HOST=                               # opcional; ex.: 127.0.0.1. Vazio = todas as interfaces

# Admin primário do login local: minúsculas, 3-58 caracteres de [a-z0-9._-] (fora disso o login local fica desabilitado).
# LOCAL_AUTH_USERNAME=
# Teto de chaves (cliente|usuário) acompanhadas pelo limitador de tentativas (padrão 1000).
# LOCAL_AUTH_MAX_TRACKED=1000
# Personas de piloto com login local (só com LOCAL_AUTH_ENABLED=1). JSON:
# [{"username":"syn.finance","role":"finance","passwordHash":"scrypt:<salt>:<hash>","displayName":"SYN Financeiro"}]
# Papéis: admin|seller|finance|service. Hash: `node scripts/hash-local-password.mjs` (senha via stdin). Nunca commitar valores.
LOCAL_AUTH_USERS=

# Segurança (KAN-30): quantos proxies confiáveis ficam na frente do app (0 = nenhum). Só >0 atrás de proxy conhecido, senão o IP do login vem forjado.
TRUST_PROXY_HOPS=0
FINANCIAL_PROJECT_MAP_ENABLED=false  # CRM-A01: true = cada empreendimento usa o projeto do Financial cadastrado em financial_project_map; sem linha usa o projeto padrão.
CONTRACT_ADDENDUM_ENABLED=false  # CRM-A12: aditivo contratual NÃO monetário (ADR-012). Desligado por padrão.
CSRF_ORIGIN_CHECK_ENABLED=false  # CRM-A26: true recusa mutação em /api/trpc cujo Origin não seja a própria origem (ligar após o HTTPS/domínio definitivo).
CSRF_ALLOWED_ORIGINS=  # CRM-A26: origens extras permitidas, separadas por vírgula (ex.: https://crm.exemplo.com.br).
